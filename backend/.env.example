# ==========================
# Application
# ==========================
APP_NAME=RAVEN Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# ==========================
# Database (dev default is hardcoded in app/core/config.py as
# sqlite:///./raven.db - only set DATABASE_URL here to override,
# e.g. production PostgreSQL)
# ==========================
# DATABASE_URL=postgresql+psycopg://user:password@db:5432/raven

# ==========================
# Security (min 16 chars — generate one per environment, never reuse)
# ==========================
SECRET_KEY=change-me-to-a-long-random-string-per-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30