# Root .env for `docker-compose up -d --build` (repo root).
# Copy to `.env` (gitignored) and set production database credentials.
#
# EC2 deploy:
#   umask 077
#   cp .env.example .env
#   # then set POSTGRES_PASSWORD below
#   docker-compose up -d --build

# The frontend binds host port 80 so the PS1/PS2 switcher can run either app
# behind the same public port. Do not run both stacks at the same time.

# Postgres (internal-only; override defaults for production).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-db-password
POSTGRES_DB=raven_db

# AWS Bedrock (EC2 IAM instance-profile provides credentials; no keys needed).
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-opus-4-8

# Direct browser→API origins (frontend normally uses the Next.js /raven/api
# proxy, so this is only for direct API access). Add any public origin if needed.
BACKEND_CORS_ORIGINS=http://localhost,http://127.0.0.1
