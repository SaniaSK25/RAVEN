# Root .env for `docker compose up -d --build` (repo root).
# Copy to `.env` (gitignored) and fill in secrets. Do NOT commit `.env`.
#
# EC2 deploy:
#   umask 077
#   cp .env.example .env
#   # then set SECRET_KEY + POSTGRES_PASSWORD below
#   docker compose up -d --build

# Required: min 16 chars. Generate per environment, never reuse.
#   openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string-per-env

# Host port for the frontend (bound to 127.0.0.1; nginx proxies /raven/ to it).
FRONTEND_PORT=3001

# Postgres (internal-only; override defaults for production).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-db-password
POSTGRES_DB=raven_db

# AWS Bedrock (EC2 IAM instance-profile provides credentials; no keys needed).
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-opus-4-8

# Direct browser→API origins (frontend normally uses the Next.js /raven/api
# proxy, so this is only for direct API access). Include the EC2 public host.
BACKEND_CORS_ORIGINS=http://52.204.215.223,http://127.0.0.1:3001,http://localhost:3001
